# ResolveLM local configuration. Copy to .env — never commit secrets.

RESOLVELM_ENV=local
RESOLVELM_API_HOST=0.0.0.0
RESOLVELM_API_PORT=8101
RESOLVELM_LOG_LEVEL=INFO
RESOLVELM_MAX_PAYLOAD_BYTES=262144
RESOLVELM_GENERATE_TIMEOUT_S=30

# Model serving
RESOLVELM_BACKEND=rule
RESOLVELM_MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct
RESOLVELM_ADAPTER_PATH=
RESOLVELM_MODEL_VERSION=rule-baseline-v1
RESOLVELM_DEVICE=auto

# Production CUDA target (documented only; not executed on Apple Silicon)
# RESOLVELM_PROD_MODEL_ID=Qwen/Qwen3-4B-Instruct-2507
# RESOLVELM_LOAD_IN_4BIT=true

# MLflow
MLFLOW_TRACKING_URI=http://127.0.0.1:5101
MLFLOW_EXPERIMENT_NAME=resolvelm

# Dashboard
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8101
NEXT_PUBLIC_MLFLOW_URI=http://127.0.0.1:5101
